table FactValidationException
	column ExceptionType
		dataType: string
		summarizeBy: none
	column BusinessKey
		dataType: string
		summarizeBy: none
	column SiteNo
		dataType: string
		summarizeBy: none
	column SourceSheet
		dataType: string
		summarizeBy: none
	column SourceRowNumber
		dataType: int64
		summarizeBy: none
	column Details
		dataType: string
		summarizeBy: none

partition FactValidationException = m
	mode: import
	source = ```
		let
			Source = Csv.Document(File.Contents("reports/prototype/fact_validation_exception.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
		in
			Promoted
		```
