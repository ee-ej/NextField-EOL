table FactSPOFObservation
	column SiteNo
		dataType: string
		summarizeBy: none
	column SPOFQuestionId
		dataType: string
		summarizeBy: none
	column AnswerValue
		dataType: string
		summarizeBy: none
	column OriginalMarker
		dataType: string
		summarizeBy: none
	column DetailedComments
		dataType: string
		summarizeBy: none
	column SourceRowNumber
		dataType: int64
		summarizeBy: none
	column SourceColumnStart
		dataType: int64
		summarizeBy: none
	column SourceColumnEnd
		dataType: int64
		summarizeBy: none
	column ValidationStatus
		dataType: string
		summarizeBy: none

partition FactSPOFObservation = m
	mode: import
	source = ```
		let
			Source = Csv.Document(File.Contents("reports/prototype/fact_spof_observation.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
		in
			Promoted
		```
