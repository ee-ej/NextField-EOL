model NextFieldEOL_V1_LocalPrototype
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	dataAccessOptions
		returnErrorValuesAsNull


table DimSite
	column SiteNo
		dataType: string
		summarizeBy: none
	column SiteName
		dataType: string
		summarizeBy: none
	column Ownership
		dataType: string
		summarizeBy: none

	column AssetClass
		dataType: string
		summarizeBy: none
	column Gen
		dataType: string
		summarizeBy: none
	column EBITDA
		dataType: double
		summarizeBy: sum
	column ValidationStatus
		dataType: string
		summarizeBy: none
	column IsRestoredRecord
		dataType: string
		summarizeBy: none


table DimAsset
	column AssetId
		dataType: string
		summarizeBy: none
	column AssetName
		dataType: string
		summarizeBy: none
	column CategoryName
		dataType: string
		summarizeBy: none
	column AssetNo
		dataType: string
		summarizeBy: none
	column SerialNo
		dataType: string
		summarizeBy: none
	column Make
		dataType: string
		summarizeBy: none
	column Model
		dataType: string
		summarizeBy: none
	column SiteId
		dataType: string
		summarizeBy: none
	column SiteNo
		dataType: string
		summarizeBy: none
	column SiteName
		dataType: string
		summarizeBy: none
	column IsTestRecord
		dataType: string
		summarizeBy: none


