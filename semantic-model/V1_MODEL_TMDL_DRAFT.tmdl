		dataType: string
		summarizeBy: none
	column SourceRowNumber
		dataType: int64
		summarizeBy: none
	column Details
		dataType: string
		summarizeBy: none

partition DimSite = m
	mode: import
	source = ```
		let
			Source = Csv.Document(File.Contents("reports/prototype/dim_site.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
		in
			Promoted
		```

