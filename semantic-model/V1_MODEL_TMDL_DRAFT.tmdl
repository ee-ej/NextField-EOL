		summarizeBy: none
	column ROMCostInBudgetYear
		dataType: double
		summarizeBy: sum
	column IsTestRecord
		dataType: string
		summarizeBy: none


table FactSiteRiskScore
	column SiteNo
		dataType: string
		summarizeBy: none
	column OverallRiskScore
		dataType: double
		summarizeBy: none
	column NumberItemsAtThreshold
