		summarizeBy: none
	column EqMainCost
		dataType: double
		summarizeBy: none
	column EqLoading
		dataType: double
		summarizeBy: none
	column ROMReplacementCost
		dataType: double
		summarizeBy: sum
	column BudgetYear
