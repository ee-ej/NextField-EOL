table DimSPOFQuestion

	column SPOFQuestionId
		dataType: string
		summarizeBy: none

	column SPOFQuestion
		dataType: string
		summarizeBy: none

	column SPOFCategory
		dataType: string
		summarizeBy: none

	partition DimSPOFQuestion = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Dev\NextField\NextField-EOL\reports\prototype\dim_spof_question.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
				    Promoted

